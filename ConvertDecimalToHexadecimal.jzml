<SCRIPT name="onLoad()" script="refresh();" trigger_script="" trigger_type="5" trigger="1" clock="0" clock_div="4" osc_message="/Pads/onLoad" midi_message="0x90,0x90,0,0" midi_target="-1" flag="1"/>
<SCRIPT name="refresh()" script="decl isHex = firstof(Switches.x) == 1;

decl i, labels;
for (i = 0; i < 256; i++) {
	labels[i] = isHex ? decToHex(i) : '' + i;
}

setattribute(getobject(), 'labels', labels);" trigger_script="" trigger_type="4" trigger="1" clock="0" clock_div="4" osc_message="/Pads/refresh" midi_message="0x90,0x90,0,0" midi_target="-1" flag="1"/>
</WINDOW>
