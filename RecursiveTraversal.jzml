<SCRIPT name="onX()" script="traverse(Container, x);" trigger_script="x" trigger_type="0" trigger="1" clock="0" clock_div="4" osc_message="/CustomButton/onX" midi_message="0x90,0x90,0,0" midi_target="-1" flag="1"/>
</WINDOW>
</WINDOW>
<SCRIPT name="traverse(object, x)" script="// Recursively traverses the UI hierarchy and sets the value of any
// object that has an 'x' expression to the input value `x`

decl child = getfirst(object);
while (child) {
	setexpression(child, 'x', x);
	traverse(child, x);
	child = getnext(child);
}" trigger_script="" trigger_type="4" trigger="1" clock="0" clock_div="4" osc_message="/traverse" midi_message="0x90,0x90,0,0" midi_target="-1" flag="1"/>
</JZML>
