<JZML>
<PROJECT version="5400" width="667" height="331" osc_target="-1" midi_target="-1" kbmouse_target="-1" skin="Flat"/>
<WINDOW class="JAZZINTERFACE" text="Default" x="0" y="0" width="667" height="331" state="1" group="0" font="tahoma,11,0" >
<WINDOW class="Canvas" text="OriginalImage" x="151" y="176" width="151" height="118" state="5" group="0" font="tahoma,10,0" send="1" osc_target="-2" midi_target="-2" kbmouse_target="-2" capture="1" redrawMode="0" touchSupport="0">
<SCRIPT name="onRedraw()" script="// The name of the image to display
decl imageName = 'Lemur-Logo';

// Get a reference to the current canvas object
decl this = getobject();

// Clear the canvas before drawing
canvas_clear(this);

// Get the size of the canvas, and extract the components
decl canvasFrame = getobjectrect(this);
decl canvasWidth = canvasFrame[2];     // Canvas width
decl canvasHeight = canvasFrame[3];    // Canvas height
decl canvasCenterX = canvasWidth / 2;  // Horizontal center
decl canvasCenterY = canvasHeight / 2; // Vertical center

// Get the image's width and height
decl imageSize = image_getDimensions(imageName);

// Space to leave around the edges
decl padding = 8;

// Maximum size the image can be, considering padding
decl maxImageSize = min(canvasWidth - 2 * padding, canvasHeight - 2 * padding);

// The image's width-to-height ratio
decl aspectRatio = imageSize[0] / imageSize[1];

// Variables to hold the scaled image size
decl imageWidth, imageHeight;

// Calculate image width and height while preserving aspect ratio
if (aspectRatio > 1) {
    // Image is wider than it is tall
    imageWidth = maxImageSize;
    imageHeight = maxImageSize / aspectRatio;
} else {
    // Image is taller than wide or square
    imageHeight = maxImageSize;
    imageWidth = maxImageSize * aspectRatio;
}

// Draw the image centered on the canvas with the computed size
canvas_drawImageScaled(this, 
    imageName, 
    canvasCenterX - imageWidth / 2,  // Center horizontally
    canvasCenterY - imageHeight / 2, // Center vertically
    imageWidth,                      // Scaled width
    imageHeight                      // Scaled height
);
" trigger_script="" trigger_type="255" trigger_name="onRedraw" trigger="1" clock="0" clock_div="4" osc_message="/OriginalImage/onRedraw" midi_message="0x90,0x90,0,0" midi_target="-1" flag="1"/>
</WINDOW>
<WINDOW class="Canvas" text="TintedImage" x="331" y="176" width="159" height="118" id="5" state="5" group="0" font="tahoma,10,0" send="1" osc_target="-2" midi_target="-2" kbmouse_target="-2" capture="1" redrawMode="0" touchSupport="0">
<SCRIPT name="onRedraw()" script="// The name of the image to display
decl imageName = 'Lemur-Logo-White';

// The tint you want to apply, specified as ARGB.
// In order for this work, the original image should be white.
decl tint = {1, 0, 1, 0};



// Get a reference to the current canvas object
decl this = getobject();

// Clear the canvas before drawing
canvas_clear(this);

// Get the size of the canvas, and extract the components
decl canvasFrame = getobjectrect(this);
decl canvasWidth = canvasFrame[2];     // Canvas width
decl canvasHeight = canvasFrame[3];    // Canvas height
decl canvasCenterX = canvasWidth / 2;  // Horizontal center
decl canvasCenterY = canvasHeight / 2; // Vertical center

// Get the image's width and height
decl imageSize = image_getDimensions(imageName);

// Space to leave around the edges
decl padding = 8;

// Maximum size the image can be, considering padding
decl maxImageSize = min(canvasWidth - 2 * padding, canvasHeight - 2 * padding);

// The image's width-to-height ratio
decl aspectRatio = imageSize[0] / imageSize[1];

// Variables to hold the scaled image size
decl imageWidth, imageHeight;

// Calculate image width and height while preserving aspect ratio
if (aspectRatio > 1) {
    // Image is wider than it is tall
    imageWidth = maxImageSize;
    imageHeight = maxImageSize / aspectRatio;
} else {
    // Image is taller than wide or square
    imageHeight = maxImageSize;
    imageWidth = maxImageSize * aspectRatio;
}

canvas_setImageStyle(this, tint);

// Draw the image centered on the canvas with the computed size
canvas_drawImageScaled(this, 
    imageName, 
    canvasCenterX - imageWidth / 2,  // Center horizontally
    canvasCenterY - imageHeight / 2, // Center vertically
    imageWidth,                      // Scaled width
    imageHeight                      // Scaled height
);
" trigger_script="" trigger_type="255" trigger_name="onRedraw" trigger="1" clock="0" clock_div="4" osc_message="/TintedImage/onRedraw" midi_message="0x90,0x90,0,0" midi_target="-1" flag="1"/>
</WINDOW>
<WINDOW class="Text" text="Text3" x="32" y="20" width="542" height="58" id="6" state="85" group="0" font="tahoma,14,0" send="1" osc_target="-2" midi_target="-2" kbmouse_target="-2" color="8355711" content="When drawing an image using the Canvas, it will be displayed in its original colors by default. However, you can apply a tint using canvas_setImageStyle(c, color)">
<VARIABLE name="light=0" send="0" osc_target="0" osc_trigger="1" osc_message="/Text3/light" midi_target="-1" midi_trigger="1" midi_message="0x90,0x90,0,0" midi_scale="0,16383" kbmouse_target="-1" kbmouse_trigger="1" kbmouse_message="0,0,0" kbmouse_scale="0,1,0,1"/>
</WINDOW>
<WINDOW class="Text" text="Text5" x="32" y="88" width="542" height="61" id="8" state="85" group="0" font="tahoma,14,0" send="1" osc_target="-2" midi_target="-2" kbmouse_target="-2" color="8355711" content="Since the tint works as a color multiplier, the original image should be white to produce accurate results. See the onRedraw() script inside each Canvas widget to learn how it works.">
<VARIABLE name="light=0" send="0" osc_target="0" osc_trigger="1" osc_message="/Text5/light" midi_target="-1" midi_trigger="1" midi_message="0x90,0x90,0,0" midi_scale="0,16383" kbmouse_target="-1" kbmouse_trigger="1" kbmouse_message="0,0,0" kbmouse_scale="0,1,0,1"/>
</WINDOW>
</WINDOW>
