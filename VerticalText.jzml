<SCRIPT name="verticalText(text)" script="// Inserts a new line after every character
// to create vertically stacked text

decl chars = stringtoarray(text);

if (sizeof(chars) <= 1) {
	return text;
}


decl verticalText = '';
decl i;
for (i = 0; i < sizeof(chars); i++) {
	verticalText += arraytostring(chars[i]);
	if (i < sizeof(chars) - 1) {
		verticalText += arraytostring(10); // ASCII code for new line
	}
}

return verticalText;" trigger_script="" trigger_type="4" trigger="1" clock="0" clock_div="4" osc_message="/verticalText" midi_message="0x90,0x90,0,0" midi_target="-1" flag="1"/>
</JZML>
